{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linkly",
  "version": "2.0.1",
  "identifier": "com.kwagdaeho.linkly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Linkly",
        "width": 980,
        "height": 880,
        "minWidth": 780,
        "minHeight": 640,
        "resizable": true,
        "devtools": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © Theo Kwag",
    "homepage": "https://github.com/KwagDaeho/Linkly",
    "shortDescription": "Linkly",
    "longDescription": "macOS menu bar input remapper.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Linkly Code Signing",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5QkYyMTc0QTE2NzBENTcKUldSWERXZWhkQ0cvU2RMak1ueC9UMmdNeHVXK3RPRU5VVitOK0Viblp6K1FQOGVET1Mxeno1RFkK",
      "endpoints": [
        "https://github.com/KwagDaeho/Linkly/releases/latest/download/latest.json"
      ]
    }
  }
}
