{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linkly",
  "version": "1.5.3",
  "identifier": "com.kwagdaeho.linkly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Linkly",
        "width": 820,
        "height": 880,
        "minWidth": 780,
        "minHeight": 640,
        "resizable": true,
        "devtools": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © Theo Kwag",
    "homepage": "https://github.com/KwagDaeho/Linkly",
    "shortDescription": "Linkly",
    "longDescription": "macOS menu bar input remapper.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
